# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB connection string (Local or MongoDB Atlas)
# Example: mongodb://127.0.0.1:27017/manish_portfolio
# Or Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/manish_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/manish_portfolio

# Client URL (for CORS in production)
CLIENT_URL=http://localhost:5173

