# MongoDB Atlas Connection
# For local development, you can use:
# MONGODB_URI=mongodb://127.0.0.1:27017/manish_portfolio

# Required Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Required for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/manish_portfolio?retryWrites=true&w=majority

# CORS Configuration (Frontend Origin)
CLIENT_URL=http://localhost:5173

# Email Notifications Configuration (Optional)
# Email service for contact form notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_TO=your_email@gmail.com

# Security Settings
# Enable rate limiting (default: true)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # 100 requests per window per IP

# Express Settings
# Body parser limit
EXPRESS_JSON_LIMIT=1mb
EXPRESS_URLENCODED_LIMIT=1mb

# Helmet Security Headers
# These are configured in server.ts

# MongoDB Configuration
# Connection timeout
MONGODB_TIMEOUT_MS=5000
MONGODB_RECONNECT_INTERVAL=12000

# Logging Configuration
# Enable detailed logging in development
LOG_LEVEL=debug

# Contact Form Configuration
# Maximum message length
CONTACT_MAX_MESSAGE_LENGTH=2000
CONTACT_MAX_NAME_LENGTH=100
CONTACT_MAX_EMAIL_LENGTH=254

# Rate Limiting for Contact Form
# Contact form submission rate limits
CONTACT_RATE_LIMIT_WINDOW_MS=3600000  # 1 hour
CONTACT_RATE_LIMIT_MAX=5  # 5 submissions per hour per IP

# File Upload Configuration (if needed)
# Maximum file size (if you add file uploads later)
MAX_FILE_SIZE_MB=5